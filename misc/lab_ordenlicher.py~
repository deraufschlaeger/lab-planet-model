def density_from_eos(pressure_profile, temperature, eos='h', **kwargs):
  ''' INPUT:
      pressure_profile = [[p1lower, p1, p1upper], [p2lower. p2, p2upper], ..., [pNlower, pN, pNupper]]
      temperature = [T1, T2, ..., Tn]
      eos = which equation of state to use? "he", "h", "rocky"(then K_0 and K'_0 and rho_0 need to be provided)

      FUNCTION gives the density from an equation of state. Different Equation of states

      OUTOUT should look like
      density = [[rho1lower, rho1, rho1upper], [rho2lower, rho2, rho2upper], ..., [rhoNlower, rhoN, rhoNupper]]
      '''
  if type(temperature) not in [np.ndarray, list]:
    temperature = np.full(len(pressure_profile), temperature)
  T = np.array(temperature)

  if eos == "he":
    density_profile = he_eos(pressure_profile, T)
  elif eos == "h":
    density_profile = h_eos(pressure_profile, T)
  elif eos == "rocky":
    if "k_0" not in kwargs or "k_d" not in kwargs or "rho_0" not in kwargs:
      raise ValueError("'k_0', 'k_d'(k_0') and 'rho_0' must be provided for the rocky equation of state")

    K_0 = kwargs['k_0']
    K_d = kwargs['k_d']
    rho_0 = kwargs['rho_0']
    density_profile = rocky_eos(pressure_profile, K_0, K_d, rho_0)
  else:
    raise ValueError(f"Unknown equation of state: {eos}")

  return density_profile


def one_cycle(mass_profile, first_density, temperature, **kwargs):
  ''' INPUT:
      mass_profile = [m1,m2,m3,..., mN]
      first_density = constant value or array of values

      FUNCTION represents one cycle

      OUTPUT should look like
      new_density = [[rho1lower, rho1, rho1upper], [rho2lower, rho2, rho2upper], ..., [rhoNlower, rhoN, rhoNupper]]
      '''

  r_profile = find_radius_profile(first_density, mass_profile) #RADIUS
  p_profile = find_pressure_profile(r_profile, mass_profile) #PRESSURE

  new_density = density_from_eos(p_profile, temperature, **kwargs) #EQUATION OF STATE

  return r_profile, p_profile, new_density

def create_mass_profile(mass_total, N, profile='constant'):
  if profile == 'constant':
    mass_profile = np.full(N, mass_total / N)
  elif profile == 'linear':
    mass_profile = np.linspace(mass_total / N, mass_total, N)
  # add more mass distribution profiles?
  return mass_profile

def create_temp_profile(T, N, profile='constant'):
  if profile == 'constant':
    T_profile = np.full(N, T)
  elif profile == 'linear':
    T_profile = np.linspace(T, 0, N) #this does not make sense right?
  return T_profile

def create_density_profile(rho, N, profile='constant'):
  if profile == 'constant':
    density_profile = np.full(N, rho)
  elif profile == 'linear':
    density_profile = np.linspace(rho, 0, N)
  return density_profile

