"""# Radiusfunktion"""

def find_radius_profile(density, mass_profile):
  ''' INPUT:
      density = constant value or array of values
      mass_profile = [m1,m2,m3,..., mN]

      OUTPUT looks like
      r_profile = [[r1lower, r1, r1upper], [r2lower, r2, r2upper], [r3lower, r3, r3upper], ... ,[rN-1lower, rN-1, rN-1upper], [rNlower, rN, rNupper]]
      '''


  N = len(mass_profile)
  r_profile = np.zeros((N,3))
  if type(density) not in [np.ndarray, list]:
    density = np.full(N, density)

  rilower = 0

  deltar = []

  for i in range(1,N): #stops @ N-1 (index of shell N is N-1)
    ''' r1lowr == 0 und rilower == ri-1upper (rNupper == Radius_gesamt(?))
    START AT SHELL NUMBER 2 (index 1)
    STEP 1: Calculate rilower
    STEP 2: set ri-1upper == rilower
    STEP 3: calculate ri-1

    STEP 4: FORMULA (15) CHECK
    '''

    if i == 1:
      r_profile[1][0] = (3*mass_profile[i]/(4*np.pi*density[i]))**(1/3) #deltar1 FORMULA (21) #STEP 1
      r_profile[0][2] = r_profile[1][0] #STEP 2
      r_profile[0][1] = r_profile[0][2]/2 #STEP 3

      rilower += mass_profile[0]/(4*np.pi*density[0]*r_profile[0][1]**2) #FORMULA (22)

      deltar.append(mass_profile[0]/(4*np.pi*density[0]*r_profile[0][1]**2))


    if i != 1:
      r_profile[i-1][1] = r_profile[i-1][0] #for now? introducing an error of deltari/2

      rilower_first = rilower + mass_profile[i-1]/(4*np.pi*density[i-1]*r_profile[i-1][1]**2) #FORMULA (22)

      r_profile[i][0] = rilower_first #STEP 1
      r_profile[i-1][2] = r_profile[i][0] #STEP 2
      r_profile[i-1][1] = (r_profile[i-1][0]+r_profile[i-1][2])/2 #STEP 3

      rilower += mass_profile[i-1]/(4*np.pi*density[i-1]*r_profile[i-1][1]**2) #FORMULA (22)

      deltar.append(mass_profile[i-1]/(4*np.pi*density[i-1]*r_profile[i-1][1]**2))

    if i == N-1: #special treatment for last shell
      deltarN = mass_profile[i]/(4*np.pi*density[i]*r_profile[i][0]**2) # FORMULA (23)
      r_profile[i][2] = r_profile[i][0] + deltarN # FORMULA (24)
      r_profile[i][1] = (r_profile[i][0]+r_profile[i][2])/2

    ''' deltariminus1 = mass_profile[i-1]/(4*np.pi*density[i-1]*r_profile[i-1][1]**2) # FORMULA (15)
      if r_profile[i-1][0] + deltariminus1 != r_profile[i-1][2]:
        print(f"FORMULA 15 difference for shell {i-1} is {r_profile[i-1][2]/(r_profile[i-1][0] + deltariminus1)}")
      elif r_profile[i-1][0] + deltariminus1 == r_profile[i-1][2]:
        print(f"FORMULA 15 works for shell {i-1}")'''

  return r_profile

"""# Pressure function"""

def find_pressure_profile(radius_profile, mass_profile):
  ''' INPUT:
      radius_profile = [[r1lower, r1, r1upper], [r2lower, r2, r2upper], [r3lower, r3, r3upper], ... , [rNlower, rN, rNupper]]
      mass_profile = [m1,m2,m3,..., mN]

      OUTPUT should look like
      pressure_profile = [[p1lower, p1, p1upper], [p2lower. p2, p2upper], ..., [pNlower, pN, pNupper]]'''

  N = len(radius_profile)
  if len(mass_profile) != N:
    raise ValueError("mass_profile and radius_profile must have the same length")

  p_profile = np.zeros((N,3))

  p_profile[-1][2] = 100000

  for i in range(N-1,0,-1): #starts @ N-1 (index of shell N) and goes down to 1 (index of shell 2)
    p_profile[i-1][2] = np.sum(G/(4*np.pi)*np.array([mass_profile[j]*np.sum([mass_profile[k] for k in range(j)]) / radius_profile[j][1]**4 for j in range(N-1, i-1,-1)])) #FORMULA (17)
    p_profile[i][0] = p_profile[i-1][2]

    p_profile[i][1] = (p_profile[i][0]+p_profile[i][2])/2 #FORMULA (16)

  #afterwards special treatment for i=0 (shell 1) [0, 0, r1upper]
  p_profile[0][0] = p_profile[0][2] + 3*G*mass_profile[0]**2/(8*np.pi*radius_profile[0][2]**4) #deltar1 FORMULA (19)
  p_profile[0][1] = (p_profile[0][0]+p_profile[0][2])/2

  return p_profile

"""# density profile iterativ"""

def rocky_eos(pressure_profile, K_0, K_d, rho_0):
  N = len(pressure_profile)
  density_profile = np.zeros(N)

  for i in range(N):
    density_profile[i] = rho_0*(1+K_d*pressure_profile[i][1]/K_0)**(1/K_d)

  return density_profile

def h_eos(pressure_profile, T):
  N = len(pressure_profile)
  if len(T) != N:
    raise ValueError("T and pressure_profile must have the same length")

  density_profile = np.zeros(N) #was before 'np.zeros((N,3))', but this does not make sense right?

  for i in range(N):
    density_profile[i] = math.exp(interpolator([math.log(T[i]),math.log(pressure_profile[i][1] / 1e9)])[0])*1000

  return density_profile

