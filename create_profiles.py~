import numpy as np

def create_mass_profile(mass_total, N, profile='constant'):
  if profile == 'constant':
    mass_profile = np.full(N, mass_total / N)
  elif profile == 'linear':
    mass_profile = np.linspace(mass_total / N, mass_total, N)
  elif type(profile) == dict:
    n_core = profile['n_core']
    core_mass_ratio = profile['core_mass_ratio']

    num_non_core = N-n_core
    mass_core = mass_total * core_mass_ratio
    mass_non_core = mass_total * (1-core_mass_ratio)

    non_core_array = np.full(num_non_core, mass_non_core/num_non_core)
    core_array = np.full(n_core, mass_core/n_core)
    mass_profile = np.append(core_array, non_core_array)
    
    # FERTIG?
  # add more mass distribution profiles?

  return mass_profile

def create_temp_profile(T, N, profile='constant'):
  if profile == 'constant':
    T_profile = np.full(N, T)
  elif profile == 'linear':
    T_profile = np.linspace(T, 0, N) #this does not make sense right?
  return T_profile

def create_density_profile(rho, N, profile='constant'):
  if profile == 'constant':
    density_profile = np.full(N, rho)
  elif profile == 'linear':
    density_profile = np.linspace(rho, 0, N)
  return density_profile
